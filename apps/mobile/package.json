{
  "name": "navis-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Navis for Android and iOS: a Capacitor shell around the hosted Navis web app.",
  "scripts": {
    "sync": "cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#4f46e5' --iconBackgroundColorDark '#4f46e5' --splashBackgroundColor '#f8f8fc' --splashBackgroundColorDark '#0b0c14'",
    "android": "cap open android",
    "ios": "cap open ios",
    "android:run": "cap run android",
    "ios:run": "cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "typescript": "^5"
  }
}
