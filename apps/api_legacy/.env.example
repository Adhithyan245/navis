# ==============================================================
# Navis API — Environment Variables
# ==============================================================
# Copy this file to .env and fill in the values.
# All keys are optional — missing keys degrade gracefully.
# The server will start with no keys (OSM is always free).
# ==============================================================

# ── Core (RECOMMENDED) ────────────────────────────────────────
# Google Places — powers Explore, Taste, Work, Settle agents
# Get yours: https://console.cloud.google.com → APIs → Places API
GOOGLE_PLACES_API_KEY=

# Google Maps — optional, for routing/directions enhancement
GOOGLE_MAPS_API_KEY=

# ── Events ────────────────────────────────────────────────────
# Eventbrite — powers Connect agent (free tier available)
# Get yours: https://www.eventbrite.com/platform/api
EVENTBRITE_API_KEY=

# Ticketmaster — optional second event source for Connect agent
# Get yours: https://developer.ticketmaster.com (free tier)
TICKETMASTER_API_KEY=

# ── Places / Food ─────────────────────────────────────────────
# Yelp Fusion — optional enrichment for Taste agent
# Get yours: https://www.yelp.com/developers/v3/manage_app (free tier)
YELP_API_KEY=

# ── Transit ───────────────────────────────────────────────────
# MBTA — optional, upgrades Boston transit from static to live
# Get yours: https://api-v3.mbta.com (free, registration optional)
MBTA_API_KEY=

# ── Jobs ──────────────────────────────────────────────────────
# Adzuna — powers Work agent job listings (free tier: 250 req/day)
# Get yours: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── AI / NLU ──────────────────────────────────────────────────
# OpenAI — powers Voice/Ask Native agent intent parsing
# Get yours: https://platform.openai.com/api-keys
# Model used: gpt-4o-mini (cost-efficient)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Database ──────────────────────────────────────────────────
# SQLite by default (no setup required)
# For production: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./navis.db
