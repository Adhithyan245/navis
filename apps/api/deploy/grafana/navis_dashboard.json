{
  "title": "Navis Orchestration Platform",
  "uid": "navis-main",
  "version": 1,
  "schemaVersion": 36,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Active NDJSON Streams",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "navis_active_streams", "legendFormat": "Active Streams" }],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Stream Cancellations (Total)",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "navis_stream_cancellations_total", "legendFormat": "Cancellations" }],
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "title": "Slow Consumer Events",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "navis_slow_consumer_total", "legendFormat": "Slow Consumers" }],
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 4,
      "title": "Event Loop Lag (seconds)",
      "type": "gauge",
      "datasource": "Prometheus",
      "targets": [{ "expr": "navis_event_loop_lag_seconds", "legendFormat": "Loop Lag" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        {"color": "green", "value": 0},
        {"color": "yellow", "value": 0.05},
        {"color": "red", "value": 0.1}
      ]}}},
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 }
    },
    {
      "id": 5,
      "title": "Provider Latency (p99)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{ "expr": "histogram_quantile(0.99, rate(navis_provider_latency_seconds_bucket[1m]))", "legendFormat": "{{provider}} p99" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "id": 6,
      "title": "Provider Timeouts & Fallbacks",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(navis_provider_timeouts_total[1m])", "legendFormat": "Timeouts {{provider}}" },
        { "expr": "rate(navis_provider_fallbacks_total[1m])", "legendFormat": "Fallbacks {{provider}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    },
    {
      "id": 7,
      "title": "Memory Usage (RSS MB)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{ "expr": "navis_memory_rss_bytes / 1024 / 1024", "legendFormat": "RSS MB" }],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 }
    },
    {
      "id": 8,
      "title": "Cache Hit/Miss Ratio",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(navis_cache_hits_total[1m])", "legendFormat": "Hits {{provider}}" },
        { "expr": "rate(navis_cache_misses_total[1m])", "legendFormat": "Misses {{provider}}" }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 }
    }
  ]
}
