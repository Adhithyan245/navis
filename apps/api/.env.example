# Navis API — copy to apps/api/.env and fill in. Never commit the real file.

# ── Environment ────────────────────────────────────────────────────────────
ENV=production                # development | production (production: API tokens required, HSTS, ops endpoints locked)
DEBUG=false
CORS_ALLOW_ORIGINS=https://app.navis.example

# ── Shared with the Next.js server (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
AUTH_INTERNAL_SECRET=
# Optional separate key for user API tokens (defaults to one derived from AUTH_INTERNAL_SECRET)
API_TOKEN_SECRET=

# ── Scale-out (required with more than one instance/worker) ────────────────
ACCOUNTS_DATABASE_URL=        # postgresql://navis:password@db-host:5432/navis  (unset → local SQLite)
REDIS_URL=                    # redis://redis-host:6379/0                         (unset → per-process memory)
WEB_CONCURRENCY=2
FORWARDED_ALLOW_IPS=10.0.0.0/8  # your load balancer range, so rate limits see real client IPs

# ── Providers with keys (all have free tiers) ─────────────────────────────
GROQ_API_KEY=                 # AI answers + Whisper voice
GEOAPIFY_API_KEY=             # places, geocoding, routing
FOURSQUARE_API_KEY=
TICKETMASTER_API_KEY=
OPENROUTESERVICE_API_KEY=
MAPTILER_API_KEY=
EVENTBRITE_API_KEY=
HUGGINGFACE_API_KEY=

# ── Push notifications (apps/mobile/README.md → "Push notifications") ────
FCM_PROJECT_ID=               # Firebase project id (Android)
FCM_SERVICE_ACCOUNT_JSON=     # service-account JSON inline, or a path to the file
APNS_KEY_ID=                  # Apple key with "Apple Push Notifications service" enabled (iOS)
APNS_TEAM_ID=
APNS_PRIVATE_KEY=             # contents of the .p8 file; \n escapes are fine
APNS_BUNDLE_ID=               # same as the app id (NAVIS_APP_ID)
APNS_USE_SANDBOX=false        # true for builds run from Xcode (development tokens)

# ── Free, keyless sources (override only to self-host) ────────────────────
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_MIN_INTERVAL_S=1.05   # set 0 with your own Nominatim
TRANSIT_ROUTING_URL=https://api.transitous.org
